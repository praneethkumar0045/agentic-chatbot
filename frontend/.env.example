# FastAPI base URL used by the Next.js server-side auth proxy.
AUTH_API_URL=http://localhost:8000/api/v1
# Must match the backend REFRESH_TOKEN_EXPIRE_DAYS setting.
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
# FastAPI API prefix used by the browser for the chat API.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
